rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // circulars collection এর জন্য
    match /circulars/{docId} {
      allow read: if true;  // সবাই পড়তে পারবে
      allow write: if true; // সবাই লিখতে পারবে - শুধু ডেভেলপমেন্ট এর জন্য
    }
    // job-circular page read korte parbe
    match /jobs/{jobId} {
      allow read: if true;
    }

    // Recent Job Solution collection এর জন্য
    match /job_solutions/{docId} {
      allow read: if true;  // সবাই পড়তে পারবে
      allow write: if true; // সবাই লিখতে পারবে - শুধু ডেভেলপমেন্ট এর জন্য
    }

    // Categories Rules
    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Blogs Rules
    match /blogs/{docId} {
      allow read: if true;

      // Anonymous visitors (no auth) may ONLY bump the read ("views") counter,
      // and only by exactly +1 (or creating it for the first time). This enables
      // the persistent, deduplicated view counter tracked via a server action.
      // Everything else still requires a signed-in user.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views is int
        && (!('views' in resource.data) || request.resource.data.views == resource.data.views + 1);
      allow write: if request.auth != null;
    }

    // Users Rules
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // বাকি সব collection lock করে দাও
    match /{document=**} {
      allow read, write: if false;
    }
  }
}