rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // circulars collection এর জন্য
    match /circulars/{docId} {
      allow read: if true;  // সবাই পড়তে পারবে
      allow write: if true; // সবাই লিখতে পারবে - শুধু ডেভেলপমেন্ট এর জন্য
    }
    // job-circular page read korte parbe
    match /jobs/{jobId} {
      allow read: if true;
    }

    // Recent Job Solution collection এর জন্য
    match /job_solutions/{docId} {
      allow read: if true;  // সবাই পড়তে পারবে
      allow write: if true; // সবাই লিখতে পারবে - শুধু ডেভেলপমেন্ট এর জন্য
    }

    // Categories Rules
    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Blogs Rules
    match /blogs/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Users Rules
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // বাকি সব collection lock করে দাও
    match /{document=**} {
      allow read, write: if false;
    }
  }
}